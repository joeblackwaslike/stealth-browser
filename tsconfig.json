{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"outDir": "dist"
	},
	"include": [
		"src",
		"test",
		"scripts/*.ts",
		"vitest.config.ts",
		"vitest.integration.config.ts"
	]
}
